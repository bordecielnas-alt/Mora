# Tout est optionnel. Par défaut, Mora utilise Claude Code connecté à ton abonnement Claude.

# PORT=3000
# HOST=127.0.0.1          # mets 0.0.0.0 pour l'ouvrir depuis ton téléphone sur le même Wi-Fi (les comptes s'activent alors)

# Comptes (actifs dès que HOST n'est pas 127.0.0.1, toujours avec Docker)
# MORA_AUTH=auto          # auto, on ou off
# MORA_ADMIN_USER=toi@exemple.fr  # adresse mail du premier compte administrateur, créé au premier lancement…
# MORA_ADMIN_PASSWORD=    # …sinon un code d'installation s'affiche dans la console
# MORA_SESSION_DAYS=30    # durée d'une connexion sans revenir sur l'app
# MORA_COOKIE_SECURE=auto # auto (HTTPS détecté via le reverse proxy), on ou off
# MORA_REFRESH_HOURS=6   # fréquence des recherches automatiques
# MORA_BATCH=12          # nombre de propositions par recherche
# MORA_MIN_PENDING=8     # relance une recherche quand la réserve passe sous ce nombre

# Moteur de recherche : auto (défaut), claude-code, api ou demo
# MORA_BACKEND=auto
# MORA_CLAUDE_MODEL=sonnet        # modèle utilisé par Claude Code (sinon celui par défaut de ton compte)
# MORA_CLAUDE_BIN=claude          # autre commande claude que celle installée avec l'app

# Seulement si tu préfères payer à l'usage avec une clé API plutôt que ton abonnement :
# ANTHROPIC_API_KEY=
# MORA_BACKEND=api
